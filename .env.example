# Optional; leave unset to use lexical and symbol search only.
SEARCH_EMBEDDING_ENDPOINT=
SEARCH_EMBEDDING_MODEL=
SEARCH_EMBEDDING_API_KEY=

# Required together for the Answer Generator role on POST /repositories/{id}/ask.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
FEATHERLESS_TIMEOUT_SECONDS=45

# Required together when retrieved evidence yields at least one claim.
MOONSHOT_API_KEY=
# Configure the exact Moonshot model identifier available to your account.
MOONSHOT_MODEL=
MOONSHOT_TIMEOUT_SECONDS=45

# Optional operator-supplied USD prices per 1M tokens; cost remains unavailable unless both are set.
FEATHERLESS_INPUT_PRICE_PER_MILLION=
FEATHERLESS_OUTPUT_PRICE_PER_MILLION=
FEATHERLESS_PRICING_VERSION=
MOONSHOT_INPUT_PRICE_PER_MILLION=
MOONSHOT_OUTPUT_PRICE_PER_MILLION=
MOONSHOT_PRICING_VERSION=
